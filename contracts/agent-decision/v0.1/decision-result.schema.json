{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/avaargsh/agent-control-panel/blob/main/contracts/agent-decision/v0.1/decision-result.schema.json",
  "title": "Agent Decision Turn Result v0.1",
  "description": "Canonical discriminated response union from a managed Agent Decision plugin.",
  "oneOf": [
    { "$ref": "#/$defs/final_response" },
    { "$ref": "#/$defs/action_proposals" },
    { "$ref": "#/$defs/needs_input" },
    { "$ref": "#/$defs/decision_error" }
  ],
  "$defs": {
    "common": {
      "type": "object",
      "required": ["protocol_version", "invocation_id", "kind"],
      "properties": {
        "protocol_version": { "const": "v0.1" },
        "invocation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "framework_metadata": {
          "type": "object",
          "maxProperties": 32,
          "description": "Bounded diagnostic metadata only; never authoritative."
        }
      }
    },
    "final_response": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_version", "invocation_id", "kind", "text", "evidence_refs"],
          "properties": {
            "protocol_version": { "const": "v0.1" },
            "invocation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
            "kind": { "const": "final_response" },
            "text": { "type": "string", "minLength": 1, "maxLength": 65536 },
            "structured_output": { "type": "object", "maxProperties": 256 },
            "evidence_refs": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 512 }
            },
            "framework_metadata": { "type": "object", "maxProperties": 32 }
          }
        }
      ]
    },
    "action_proposals": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_version", "invocation_id", "kind", "proposals"],
          "properties": {
            "protocol_version": { "const": "v0.1" },
            "invocation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
            "kind": { "const": "action_proposals" },
            "proposals": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "proposal_id",
                  "capability_id",
                  "capability_version",
                  "arguments",
                  "target_resource_ref",
                  "rationale_ref"
                ],
                "properties": {
                  "proposal_id": { "type": "string", "minLength": 1, "maxLength": 256 },
                  "capability_id": { "type": "string", "minLength": 1, "maxLength": 256 },
                  "capability_version": { "type": "string", "minLength": 1, "maxLength": 128 },
                  "arguments": { "type": "object", "maxProperties": 128 },
                  "target_resource_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
                  "rationale_ref": { "type": "string", "minLength": 1, "maxLength": 512 }
                }
              }
            },
            "framework_metadata": { "type": "object", "maxProperties": 32 }
          }
        }
      ]
    },
    "needs_input": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_version", "invocation_id", "kind", "prompt", "missing_fields"],
          "properties": {
            "protocol_version": { "const": "v0.1" },
            "invocation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
            "kind": { "const": "needs_input" },
            "prompt": { "type": "string", "minLength": 1, "maxLength": 8192 },
            "missing_fields": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "minLength": 1, "maxLength": 256 },
              "uniqueItems": true
            },
            "framework_metadata": { "type": "object", "maxProperties": 32 }
          }
        }
      ]
    },
    "decision_error": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_version", "invocation_id", "kind", "code", "retryable", "safe_message"],
          "properties": {
            "protocol_version": { "const": "v0.1" },
            "invocation_id": { "type": "string", "minLength": 1, "maxLength": 256 },
            "kind": { "const": "decision_error" },
            "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
            "retryable": { "type": "boolean" },
            "safe_message": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "framework_metadata": { "type": "object", "maxProperties": 32 }
          }
        }
      ]
    }
  }
}